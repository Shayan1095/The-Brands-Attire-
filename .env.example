# ---------- Required in production ----------
# Postgres connection string (Neon free tier works; Vercel's Neon integration sets this for you).
# Leave empty locally: the app then uses an embedded Postgres (PGlite) stored in ./.data
DATABASE_URL=

# Long random string used to sign admin sessions:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# First admin account (created automatically when the admins table is empty)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Public address of the site, used in links inside emails / WhatsApp messages
SITE_URL=http://localhost:3000

# ---------- Image storage (production) ----------
# Vercel Blob token (Vercel dashboard -> Storage -> Blob). Without it images are saved to ./public/uploads (local only)
BLOB_READ_WRITE_TOKEN=

# ---------- Email (any SMTP: Gmail app password, Brevo, Resend SMTP...) ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="The Brands Attire <you@example.com>"
# Where owner alerts (new order, low stock) are sent
OWNER_EMAIL=

# ---------- WhatsApp Cloud API (optional; without it messages become one-click "send" links in the panel) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Scheduled jobs ----------
# Any random string; Vercel Cron sends it automatically as a Bearer token
CRON_SECRET=

# Set to 1 to load the 12 demo products into an empty production database
SEED_DEMO=

# ---------- Customer assistant (website chat + WhatsApp) ----------
# Works with no key at all (built-in answers from your stock, orders and policies).
# For natural conversation add ONE of these. Gemini and Groq have free tiers.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a different model name, or any OpenAI-compatible endpoint (AI_BASE_URL + AI_API_KEY)
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# To receive customers' WhatsApp messages: webhook URL is <your site>/api/whatsapp
# Any random string; type the same one into Meta's webhook form
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard -> App settings -> Basic -> App secret (proves messages really come from Meta)
WHATSAPP_APP_SECRET=
